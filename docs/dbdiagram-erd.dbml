// DBML for dbdiagram.io
// IELTS AI Learning Platform - PostgreSQL database diagram

Project "IELTS AI Learning Platform" {
  database_type: "PostgreSQL"
  Note: '''
    Database stores source learning data and AI-generated content.
    Source data: passages, transcripts, prompts, vocabulary, grammar, rubrics.
    AI-generated data: questions, answers, explanations, grading results, recommendations.
  '''
}

Enum user_role {
  learner
  admin
}

Enum skill_type {
  reading
  listening
  writing
  speaking
  vocabulary
  grammar
}

Enum content_status {
  draft
  reviewed
  published
  rejected
  archived
}

Enum source_type {
  self_created
  ai_created
  open_dataset
  user_generated
}

Enum generation_status {
  pending
  processing
  completed
  failed
}

Enum writing_task_type {
  task_1
  task_2
}

Enum speaking_part {
  part_1
  part_2
  part_3
}

Enum submission_type {
  writing
  speaking
}

Enum memory_status {
  new
  learning
  reviewing
  mastered
}

Table users {
  id uuid [pk, default: `gen_random_uuid()`]
  full_name varchar(255) [not null]
  email varchar(255) [not null, unique]
  password_hash text [not null]
  role user_role [not null, default: 'learner']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: "Stores learner and admin accounts."
}

Table learner_profiles {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, unique]
  current_band numeric(3,1)
  target_band numeric(3,1)
  weak_skills jsonb
  daily_study_minutes integer
  placement_completed boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: "Stores learner IELTS target, current estimated band, and personalization settings."
}

Table topics {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(100) [not null, unique]
  description text
  created_at timestamptz [not null, default: `now()`]

  Note: "IELTS topics such as Education, Environment, Technology, Health."
}

Table levels {
  id uuid [pk, default: `gen_random_uuid()`]
  cefr_level varchar(10) [not null]
  ielts_band_min numeric(3,1) [not null]
  ielts_band_max numeric(3,1) [not null]
  description text

  Note: "Maps CEFR levels to IELTS band ranges."
}

Table source_materials {
  id uuid [pk, default: `gen_random_uuid()`]
  skill skill_type [not null]
  title varchar(255) [not null]
  topic_id uuid
  level_id uuid
  content_text text
  media_url text
  transcript text
  source_type source_type [not null, default: 'self_created']
  license_info text
  status content_status [not null, default: 'draft']
  created_by uuid
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (skill, status) [name: "idx_source_materials_skill_status"]
    (topic_id, level_id) [name: "idx_source_materials_topic_level"]
  }

  Note: '''
    Central source content table.
    Reading: content_text is passage.
    Listening: media_url is audio, transcript is listening script.
    Writing/Speaking: content_text can be prompt text.
  '''
}

Table reading_passages {
  id uuid [pk, default: `gen_random_uuid()`]
  source_material_id uuid [unique]
  title varchar(255) [not null]
  passage_text text [not null]
  topic_id uuid
  level_id uuid
  estimated_band numeric(3,1)
  word_count integer
  status content_status [not null, default: 'draft']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (topic_id, level_id) [name: "idx_reading_passages_topic_level"]
    status [name: "idx_reading_passages_status"]
  }

  Note: "Stores Reading source passages. AI generates questions, answers, explanations, and evidence from passage_text."
}

Table listening_materials {
  id uuid [pk, default: `gen_random_uuid()`]
  source_material_id uuid [unique]
  title varchar(255) [not null]
  audio_url text [not null]
  transcript text [not null]
  topic_id uuid
  level_id uuid
  accent varchar(100)
  duration_seconds integer
  status content_status [not null, default: 'draft']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (topic_id, level_id) [name: "idx_listening_materials_topic_level"]
    status [name: "idx_listening_materials_status"]
  }

  Note: "Stores Listening audio URL and transcript. Audio file should be stored outside PostgreSQL."
}

Table transcript_segments {
  id uuid [pk, default: `gen_random_uuid()`]
  listening_material_id uuid [not null]
  start_time numeric(8,2) [not null]
  end_time numeric(8,2) [not null]
  speaker varchar(100)
  segment_text text [not null]
  order_index integer [not null]

  indexes {
    (listening_material_id, order_index) [name: "idx_transcript_segments_order"]
  }

  Note: "Stores segmented transcript with timestamps for Listening explanations and replay."
}

Table writing_prompts {
  id uuid [pk, default: `gen_random_uuid()`]
  source_material_id uuid [unique]
  task_type writing_task_type [not null]
  prompt_text text [not null]
  chart_image_url text
  essay_type varchar(100)
  topic_id uuid
  level_id uuid
  status content_status [not null, default: 'draft']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (task_type, status) [name: "idx_writing_prompts_task_status"]
    (topic_id, level_id) [name: "idx_writing_prompts_topic_level"]
  }

  Note: "Stores Writing Task 1/Task 2 prompts. Optional source_material_id keeps traceability to source data."
}

Table speaking_prompts {
  id uuid [pk, default: `gen_random_uuid()`]
  source_material_id uuid [unique]
  part speaking_part [not null]
  topic_id uuid
  prompt_text text [not null]
  cue_points jsonb
  level_id uuid
  status content_status [not null, default: 'draft']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (part, status) [name: "idx_speaking_prompts_part_status"]
    (topic_id, level_id) [name: "idx_speaking_prompts_topic_level"]
  }

  Note: "Stores IELTS Speaking Part 1 questions, Part 2 cue cards, and Part 3 prompts. Optional source_material_id keeps traceability to source data."
}

Table prompt_templates {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(255) [not null]
  task_type varchar(100) [not null]
  template_text text [not null]
  output_schema jsonb
  version varchar(50) [not null]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (task_type, is_active) [name: "idx_prompt_templates_task_active"]
  }

  Note: "Stores reusable AI prompts and expected JSON output schemas."
}

Table ai_generation_requests {
  id uuid [pk, default: `gen_random_uuid()`]
  source_material_id uuid
  requested_by uuid
  generation_type varchar(100) [not null]
  input_parameters jsonb
  prompt_template_id uuid
  model_name varchar(100)
  raw_response jsonb
  status generation_status [not null, default: 'pending']
  error_message text
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (source_material_id, generation_type) [name: "idx_ai_generation_source_type"]
    status [name: "idx_ai_generation_status"]
  }

  Note: "Stores each AI generation call for debugging, audit, and regeneration."
}

Table generated_exercises {
  id uuid [pk, default: `gen_random_uuid()`]
  generation_request_id uuid
  source_material_id uuid
  skill skill_type [not null]
  title varchar(255) [not null]
  topic_id uuid
  level_id uuid
  question_type varchar(100)
  estimated_time_minutes integer
  status content_status [not null, default: 'draft']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (skill, status) [name: "idx_generated_exercises_skill_status"]
    (topic_id, level_id) [name: "idx_generated_exercises_topic_level"]
  }

  Note: "Represents a practice exercise generated by AI from source data."
}

Table generated_questions {
  id uuid [pk, default: `gen_random_uuid()`]
  exercise_id uuid [not null]
  question_text text [not null]
  question_type varchar(100) [not null]
  order_index integer [not null]
  options jsonb
  correct_answer jsonb [not null]
  explanation text
  evidence_text text
  evidence_location varchar(255)
  timestamp_start numeric(8,2)
  timestamp_end numeric(8,2)
  difficulty varchar(50)
  status content_status [not null, default: 'draft']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (exercise_id, order_index) [name: "idx_generated_questions_exercise_order"]
  }

  Note: '''
    Stores AI-generated questions, answers, explanations.
    Reading should include evidence_text/evidence_location.
    Listening can include timestamp_start/timestamp_end.
  '''
}

Table practice_attempts {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  exercise_id uuid [not null]
  skill skill_type [not null]
  started_at timestamptz [not null, default: `now()`]
  submitted_at timestamptz
  score numeric(6,2)
  max_score numeric(6,2)
  estimated_band numeric(3,1)
  time_spent_seconds integer

  indexes {
    (user_id, skill, submitted_at) [name: "idx_practice_attempts_user_skill"]
    exercise_id [name: "idx_practice_attempts_exercise"]
  }

  Note: "Stores attempts for Reading, Listening, Vocabulary quiz, and Grammar exercises."
}

Table user_answers {
  id uuid [pk, default: `gen_random_uuid()`]
  attempt_id uuid [not null]
  question_id uuid [not null]
  answer jsonb [not null]
  is_correct boolean
  score numeric(6,2)
  feedback text
  created_at timestamptz [not null, default: `now()`]

  indexes {
    attempt_id [name: "idx_user_answers_attempt"]
    question_id [name: "idx_user_answers_question"]
  }

  Note: "Stores learner answers for each generated question."
}

Table rubrics {
  id uuid [pk, default: `gen_random_uuid()`]
  skill skill_type [not null]
  task_type varchar(100)
  criterion varchar(100) [not null]
  band_score numeric(3,1) [not null]
  descriptor_text text [not null]
  version varchar(50)
  source_reference text
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (skill, task_type, criterion, band_score) [name: "idx_rubrics_lookup"]
  }

  Note: "Stores IELTS Writing and Speaking band descriptors used by AI grading prompts."
}

Table writing_submissions {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  writing_prompt_id uuid [not null]
  essay_text text [not null]
  word_count integer
  submitted_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, submitted_at) [name: "idx_writing_submissions_user"]
    writing_prompt_id [name: "idx_writing_submissions_prompt"]
  }

  Note: "Stores learner Writing Task 1/Task 2 submissions."
}

Table speaking_sessions {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  topic_id uuid
  part speaking_part [not null]
  started_at timestamptz [not null, default: `now()`]
  ended_at timestamptz
  overall_band numeric(3,1)

  indexes {
    (user_id, started_at) [name: "idx_speaking_sessions_user"]
    (topic_id, part) [name: "idx_speaking_sessions_topic_part"]
  }

  Note: "Stores one Speaking practice session."
}

Table speaking_turns {
  id uuid [pk, default: `gen_random_uuid()`]
  session_id uuid [not null]
  speaking_prompt_id uuid
  question_text text [not null]
  answer_text text
  audio_url text
  transcript text
  duration_seconds integer
  order_index integer [not null]
  is_ai_follow_up boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (session_id, order_index) [name: "idx_speaking_turns_session_order"]
    speaking_prompt_id [name: "idx_speaking_turns_prompt"]
  }

  Note: "Stores each question-answer turn in a Speaking session. AI follow-up questions are stored here too."
}

Table ai_grading_results {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  submission_type submission_type [not null]
  writing_submission_id uuid
  speaking_turn_id uuid
  overall_band numeric(3,1)
  criterion_scores jsonb
  strengths jsonb
  weaknesses jsonb
  grammar_errors jsonb
  vocabulary_suggestions jsonb
  pronunciation_metrics jsonb
  feedback_text text
  improved_answer_text text
  model_name varchar(100)
  prompt_template_id uuid
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, created_at) [name: "idx_ai_grading_user"]
    writing_submission_id [name: "idx_ai_grading_writing_submission"]
    speaking_turn_id [name: "idx_ai_grading_speaking_turn"]
  }

  Note: '''
    Stores AI grading results for Writing and Speaking.
    Use writing_submission_id for Writing grading.
    Use speaking_turn_id for Speaking grading.
    Add a database CHECK constraint so exactly one of the two columns is not null.
  '''
}

Table vocabulary_items {
  id uuid [pk, default: `gen_random_uuid()`]
  word varchar(100) [not null]
  ipa varchar(100)
  part_of_speech varchar(50)
  meaning_vi text
  definition_en text
  example_sentence text
  collocations jsonb
  synonyms jsonb
  antonyms jsonb
  topic_id uuid
  level_id uuid
  audio_url text
  status content_status [not null, default: 'draft']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (topic_id, level_id) [name: "idx_vocab_topic_level"]
    word [name: "idx_vocab_word"]
  }

  Note: "Stores IELTS vocabulary by topic and level for flashcards and quizzes."
}

Table user_vocabulary_progress {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  vocabulary_item_id uuid [not null]
  memory_status memory_status [not null, default: 'new']
  ease_score numeric(4,2)
  next_review_at timestamptz
  review_count integer [not null, default: 0]
  last_reviewed_at timestamptz

  indexes {
    (user_id, vocabulary_item_id) [unique, name: "user_vocab_unique"]
    (user_id, next_review_at) [name: "idx_vocab_progress_review"]
  }

  Note: "Stores flashcard progress and spaced repetition scheduling."
}

Table grammar_topics {
  id uuid [pk, default: `gen_random_uuid()`]
  title varchar(255) [not null]
  level_id uuid
  explanation text
  formula text
  examples jsonb
  common_mistakes jsonb
  ielts_application text
  status content_status [not null, default: 'draft']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    level_id [name: "idx_grammar_topics_level"]
    status [name: "idx_grammar_topics_status"]
  }

  Note: "Stores grammar lessons by level with examples and common mistakes."
}

Table grammar_exercises {
  id uuid [pk, default: `gen_random_uuid()`]
  grammar_topic_id uuid [not null]
  generated_exercise_id uuid
  exercise_type varchar(100) [not null]
  question_text text [not null]
  options jsonb
  correct_answer jsonb [not null]
  explanation text
  status content_status [not null, default: 'draft']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    grammar_topic_id [name: "idx_grammar_exercises_topic"]
    generated_exercise_id [name: "idx_grammar_exercises_generated"]
  }

  Note: "Stores grammar exercises created manually or generated by AI."
}

Table user_grammar_progress {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  grammar_topic_id uuid [not null]
  mastery_level numeric(4,2)
  correct_count integer [not null, default: 0]
  incorrect_count integer [not null, default: 0]
  last_practiced_at timestamptz

  indexes {
    (user_id, grammar_topic_id) [unique, name: "user_grammar_unique"]
    user_id [name: "idx_user_grammar_user"]
  }

  Note: "Stores learner progress for grammar topics."
}

Table learning_recommendations {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  recommendation_type varchar(100) [not null]
  recommendation_text text [not null]
  recommended_items jsonb
  reason text
  status content_status [not null, default: 'draft']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, created_at) [name: "idx_learning_recommendations_user"]
    (user_id, status) [name: "idx_learning_recommendations_status"]
  }

  Note: "Stores AI-generated personalized learning recommendations."
}

// Core relationships
Ref: learner_profiles.user_id - users.id [delete: cascade]
Ref: source_materials.created_by > users.id [delete: set null]
Ref: source_materials.topic_id > topics.id [delete: set null]
Ref: source_materials.level_id > levels.id [delete: set null]

Ref: reading_passages.source_material_id - source_materials.id [delete: cascade]
Ref: reading_passages.topic_id > topics.id [delete: set null]
Ref: reading_passages.level_id > levels.id [delete: set null]

Ref: listening_materials.source_material_id - source_materials.id [delete: cascade]
Ref: listening_materials.topic_id > topics.id [delete: set null]
Ref: listening_materials.level_id > levels.id [delete: set null]
Ref: transcript_segments.listening_material_id > listening_materials.id [delete: cascade]

Ref: writing_prompts.topic_id > topics.id [delete: set null]
Ref: writing_prompts.level_id > levels.id [delete: set null]
Ref: writing_prompts.source_material_id - source_materials.id [delete: set null]

Ref: speaking_prompts.topic_id > topics.id [delete: set null]
Ref: speaking_prompts.level_id > levels.id [delete: set null]
Ref: speaking_prompts.source_material_id - source_materials.id [delete: set null]

// AI generation relationships
Ref: prompt_templates.id < ai_generation_requests.prompt_template_id [delete: set null]
Ref: ai_generation_requests.source_material_id > source_materials.id [delete: set null]
Ref: ai_generation_requests.requested_by > users.id [delete: set null]

Ref: generated_exercises.generation_request_id > ai_generation_requests.id [delete: set null]
Ref: generated_exercises.source_material_id > source_materials.id [delete: set null]
Ref: generated_exercises.topic_id > topics.id [delete: set null]
Ref: generated_exercises.level_id > levels.id [delete: set null]
Ref: generated_questions.exercise_id > generated_exercises.id [delete: cascade]

// Practice relationships
Ref: practice_attempts.user_id > users.id [delete: cascade]
Ref: practice_attempts.exercise_id > generated_exercises.id [delete: cascade]
Ref: user_answers.attempt_id > practice_attempts.id [delete: cascade]
Ref: user_answers.question_id > generated_questions.id [delete: cascade]

// Writing relationships
Ref: writing_submissions.user_id > users.id [delete: cascade]
Ref: writing_submissions.writing_prompt_id > writing_prompts.id [delete: restrict]

// Speaking relationships
Ref: speaking_sessions.user_id > users.id [delete: cascade]
Ref: speaking_sessions.topic_id > topics.id [delete: set null]
Ref: speaking_turns.session_id > speaking_sessions.id [delete: cascade]
Ref: speaking_turns.speaking_prompt_id > speaking_prompts.id [delete: set null]

// AI grading relationships
Ref: ai_grading_results.user_id > users.id [delete: cascade]
Ref: ai_grading_results.prompt_template_id > prompt_templates.id [delete: set null]
Ref: ai_grading_results.writing_submission_id > writing_submissions.id [delete: cascade]
Ref: ai_grading_results.speaking_turn_id > speaking_turns.id [delete: cascade]

// Vocabulary relationships
Ref: vocabulary_items.topic_id > topics.id [delete: set null]
Ref: vocabulary_items.level_id > levels.id [delete: set null]
Ref: user_vocabulary_progress.user_id > users.id [delete: cascade]
Ref: user_vocabulary_progress.vocabulary_item_id > vocabulary_items.id [delete: cascade]

// Grammar relationships
Ref: grammar_topics.level_id > levels.id [delete: set null]
Ref: grammar_exercises.grammar_topic_id > grammar_topics.id [delete: cascade]
Ref: grammar_exercises.generated_exercise_id > generated_exercises.id [delete: set null]
Ref: user_grammar_progress.user_id > users.id [delete: cascade]
Ref: user_grammar_progress.grammar_topic_id > grammar_topics.id [delete: cascade]

// Recommendation relationships
Ref: learning_recommendations.user_id > users.id [delete: cascade]
